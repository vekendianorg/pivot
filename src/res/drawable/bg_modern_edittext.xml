<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/modern_surface_elevated" />
            <stroke
                android:width="1.5dip"
                android:color="@color/modern_accent" />
            <corners
                android:radius="@dimen/corner_radius_small" />
            <padding
                android:left="10.0dip"
                android:top="6.0dip"
                android:right="10.0dip"
                android:bottom="6.0dip" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/modern_surface_elevated" />
            <stroke
                android:width="1.0dip"
                android:color="@color/modern_divider" />
            <corners
                android:radius="@dimen/corner_radius_small" />
            <padding
                android:left="10.0dip"
                android:top="6.0dip"
                android:right="10.0dip"
                android:bottom="6.0dip" />
        </shape>
    </item>
</selector>